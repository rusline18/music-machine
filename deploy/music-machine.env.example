# Runtime settings, read by systemd from /etc/music-machine.env.
# After editing: sudo systemctl restart music-machine

NODE_ENV=production
# Only Caddy talks to Node: listen on localhost.
HOST=127.0.0.1
PORT=3000

# Public address of the site (hreflang links). setup.sh fills it in.
NUXT_PUBLIC_I18N_BASE_URL=https://example.ru

# Behind Caddy every request comes from 127.0.0.1; trust X-Forwarded-For
# so the feedback rate limit sees real visitors.
NUXT_FEEDBACK_TRUST_PROXY=true

# "Send feedback" in the footer. Stored in /srv/music-machine/.data/feedback.
NUXT_PUBLIC_FEEDBACK_ENABLED=false
# Also POST each piece of feedback here (Telegram bot bridge, Slack, …).
NUXT_FEEDBACK_WEBHOOK_URL=

# Donation page (Boosty, …), https only. Empty hides the button.
NUXT_PUBLIC_DONATE_URL=
