# Caddy: HTTPS (Let's Encrypt, renewed automatically) in front of Node.
# setup.sh replaces example.ru with your domain and installs this as
# /etc/caddy/Caddyfile. Security and cache headers come from the app
# (nuxt.config.ts), so Caddy only proxies.

example.ru {
	# Static files arrive already compressed from Nitro; this covers
	# server-rendered pages. Caddy skips responses that are already encoded.
	encode zstd gzip
	# Caddy replaces any X-Forwarded-For a visitor sends with their real
	# address; the feedback rate limit trusts its first entry. Before adding
	# `trusted_proxies` or putting a CDN in front, make sure the first entry
	# is still the visitor, or the limit can be dodged with a forged header.
	reverse_proxy 127.0.0.1:3000
}

www.example.ru {
	redir https://example.ru{uri} permanent
}
